# ==============================================================================
# PONG HOSPITAL - PROFESSIONAL SECURITY CONFIGURATION (v2026.01.31 - Sitemap Support)
# ==============================================================================
# Environment: Node.js / Next.js via Apache Proxy
# Objective:   Maximum Security + Dynamic Sitemap Support
# ==============================================================================

# ----------------------------------------------------------------------
# | 1. SECURITY HEADERS (เกราะป้องกันฝั่ง Browser)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # ป้องกันการถูกฝังหน้าเว็บใน Iframe (Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"
    
    # บังคับให้ Browser ไม่เดาชนิดไฟล์ (MIME Sniffing)
    Header set X-Content-Type-Options "nosniff"
    
    # ป้องกัน XSS Attack แบบพื้นฐาน
    Header set X-XSS-Protection "1; mode=block"
    
    # ควบคุมการส่งข้อมูล Referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # บังคับใช้ HTTPS (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # ปิดฟีเจอร์ที่ไม่จำเป็น
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # ปิดบังข้อมูล Server
    Header unset X-Powered-By
    Header unset Server
    
    # ปรับแต่ง Cookie
    Header edit Set-Cookie ^(.*)$ "$1; HttpOnly; Secure; SameSite=Lax"
    
    # ตั้งค่า Header สำหรับ Sitemap เพื่อให้แน่ใจว่า Bot อ่านได้
    <FilesMatch "^(sitemap\.xml|sitemap\.php)$">
        Header unset X-Robots-Tag
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# | 2. WEB APPLICATION FIREWALL (WAF) & BOT PROTECTION
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- 2.1 Block Bad User-Agents ---
    RewriteCond %{HTTP_USER_AGENT} ^(sqlmap|nikto|wpscan|python-requests|libwww-perl|curl|wget) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (havij|absinthe|netsparker|appscan|burp|acunetix|hydra|masscan) [NC]
    RewriteRule .* - [F,L]

    # --- 2.2 Block Malicious Query Strings ---
    RewriteCond %{QUERY_STRING} (union.*select|insert.*into|update.*set|delete.*from) [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_decode|eval\(|passwd|boot\.ini|/etc/shadow|/proc/self) [NC,OR]
    RewriteCond %{QUERY_STRING} (<script>|javascript:|vbscript:|onload=|onerror=) [NC]
    RewriteRule .* - [F,L]

    # --- 2.3 Block Directory Traversal ---
    RewriteCond %{QUERY_STRING} \.\.\/ [NC,OR]
    RewriteCond %{QUERY_STRING} \.\.\\ [NC]
    RewriteRule .* - [F,L]

    # --- 2.4 Block Log4Shell ---
    RewriteCond %{QUERY_STRING} jndi:ldap [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} \$\{jndi: [NC]
    RewriteRule .* - [F,L]

    # --- 2.5 Block Scanner Paths ---
    RewriteRule ^(wp-login\.php|xmlrpc\.php|composer\.json|package\.json|yarn\.lock)$ - [F,L]
    RewriteRule ^(wp-admin|wp-content|wp-includes|phpmyadmin|admin|install|backup|old|test)$ - [F,L]
    RewriteRule ^(serverlogin|sign|adminLogin|controlpanel|ccms|showlogin|auth|_adm|user|cpanel|maintenance|member|account|validate|mcp|bonita|jasperserver)$ - [F,L]

    # --- 2.6 Sitemap & PHP Handling (แก้ไขใหม่!) ---
    
    # (A) ถ้าเรียก sitemap.xml ให้เปลี่ยนไปรัน sitemap.php แทน
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # (B) บล็อกไฟล์ PHP ทั้งหมด *ยกเว้น* sitemap.php (Security หัวใจสำคัญ)
    RewriteCond %{REQUEST_URI} !^/sitemap\.php$
    RewriteRule \.php$ - [F,L]

</IfModule>

# ----------------------------------------------------------------------
# | 3. IP BLACKLIST (รวมมิตรผู้รุกราน - อัปเดตล่าสุด)
# ----------------------------------------------------------------------
<LimitExcept GET POST HEAD OPTIONS PUT DELETE PATCH>
    Require all denied
</LimitExcept>

<RequireAll>
    Require all granted
    
    # --- Group 1: Google Cloud Scanners ---
    Require not ip 8.34.210.41
    Require not ip 8.34.210.44
    Require not ip 8.34.210.55
    Require not ip 34.68.34.95
    Require not ip 34.68.34.83
    Require not ip 34.68.34.92

    # --- Group 2: Data Thieves & .env Hunters ---
    Require not ip 206.238.73.183
    Require not ip 34.222.105.144
    Require not ip 54.85.158.54

    # --- Group 3: The AWS Botnet Gang ---
    Require not ip 34.19.116
    Require not ip 34.19.127

    # --- Group 4: Other Known Attackers ---
    Require not ip 54.155.140.84
    Require not ip 104.131.189.0
    Require not ip 213.108.0.73
    Require not ip 182.79.81.30
    Require not ip 43.159.152.184
    Require not ip 89.104.111.58
    Require not ip 119.59.120.14
    Require not ip 80.78.27.113
    Require not ip 39.194.1
    Require not ip 52.207.253.250
    Require not ip 54.198.231.17
    Require not ip 3.88.128.54
</RequireAll>

# ----------------------------------------------------------------------
# | 4. FILE SYSTEM PROTECTION
# ----------------------------------------------------------------------
Options -Indexes

<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

<FilesMatch "^(package\.json|package-lock\.json|yarn\.lock|\.env|\.env\..*|\.git.*|\.htpasswd|web\.config|phpinfo\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(bak|backup|log|sql|sqlite|old|orig|save|tmp|ps1|sh|yaml|yml|config|ini|rar|zip)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(?:src|server|database|scripts|node_modules|\.git|\.svn|\.hg|\.bzr|\.vscode)(?:/|$)

# ----------------------------------------------------------------------
# | 5. PERFORMANCE & CACHING
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/javascript js mjs
    AddType application/json json
    AddType image/svg+xml svg svgz
    AddEncoding gzip svgz
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|css|js|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>